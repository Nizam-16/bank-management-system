# ==============================================================================
# BANK MANAGEMENT SYSTEM ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret & Expiry
JWT_SECRET=super_secret_bank_jwt_key_2024_secure_and_reliable_token
JWT_EXPIRES_IN=24h

# Oracle Database 21c XE Connection Settings
# DB_MODE: "oracle" for live Oracle XE DB connection, "mock" for in-memory PL/SQL engine simulation
DB_MODE=mock
ORACLE_USER=BANKADMIN
ORACLE_PASSWORD=BankSecret123
ORACLE_CONNECT_STRING=localhost:1521/XEPDB1

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
